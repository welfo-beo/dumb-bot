{
  "name": "dumb-bot",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Composable Pi-based agent runtime with explicit adapters and capabilities",
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "npm run test:node && npm run test:memory",
    "test:node": "node --import tsx --test packages/security/test/security.test.js test/adapters/provider/freellmapi.contract.test.ts test/extensions/adhd/adhd-extension.test.ts test/core/*.test.ts test/integration/security-memory.integration.test.ts test/integration/cli-hindsight.integration.test.ts",
    "test:memory": "vitest run test/adapters/memory/hindsight.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
